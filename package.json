{
  "name": "statex",
  "productName": "Statex",
  "version": "0.3.0",
  "description": "Cuotas, partidos, stats de jugadores y registro de apuestas de LoL esports",
  "author": "Jordi",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "backend": "docker compose up -d --build",
    "backend:logs": "docker compose logs -f --tail 100",
    "backend:stop": "docker compose down",
    "backend:debug": "docker compose --profile debug up -d --build",
    "backend:prod": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build",
    "db:backup": "node scripts/backup.js",
    "db:restore": "node scripts/restore.js",
    "test": "node --test \"server/test/**/*.test.js\"",
    "extension": "node scripts/extension.js"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tanstack/react-query": "^5.85.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.2.0",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0"
  }
}
