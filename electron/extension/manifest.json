{
  "manifest_version": 3,
  "name": "LoL Esports Tracker · cuotas",
  "version": "1.0.0",
  "description": "Recoge las cuotas de Bet365, Winamax y Betway para LoL Esports Tracker cuando pulsas «Actualizar cuotas» en la app.",
  "permissions": ["tabs", "scripting"],
  "host_permissions": [
    "https://*.bet365.es/*",
    "https://*.winamax.es/*",
    "https://*.betway.es/*",
    "http://127.0.0.1/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["http://127.0.0.1/*"], "js": ["pagina.js"], "run_at": "document_idle" }]
}
