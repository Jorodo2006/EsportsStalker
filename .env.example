# Copia este fichero como .env en la carpeta del proyecto (junto a docker-compose.yml) y rellena lo que uses.
# Docker Compose lo pasa a los servicios del backend. El .env no se sube a git.
# Lo que pongas aquí manda sobre lo guardado en Ajustes. Tras cambiarlo: npm run backend

# Leaguepedia (opcional): "bot password" de Fandom para subir el límite de consultas.
# Créala en https://lol.fandom.com/wiki/Special:BotPasswords (sólo permiso de lectura).
LEAGUEPEDIA_USER=TuUsuario@app
LEAGUEPEDIA_PASSWORD=

# lolesports.com: clave pública que usa su propia web (ya viene puesta en la app; sólo si cambia)
# LOLESPORTS_KEY=

# Base de datos (PostgreSQL en Docker). Sólo se abre en 127.0.0.1; si no pones nada se usa lolet/lolet.
# Cámbialos antes del primer arranque: después la base de datos ya está creada con los anteriores.
# POSTGRES_USER=lolet
# POSTGRES_PASSWORD=lolet
# POSTGRES_DB=lolet
# Puerto de Adminer (visor web de la base de datos) en 127.0.0.1; por defecto 8080.
# ADMINER_PORT=8080
# WEB_PORT=8090
# WEB_BIND=127.0.0.1  # para que la web no se abra a la red (por defecto se puede entrar desde el móvil)

# Entrar con Google (opcional, gratis). Sin estas tres variables el botón «Continuar con Google» no sale.
# 1. https://console.cloud.google.com → crea un proyecto → «APIs y servicios» → «Pantalla de consentimiento de OAuth»
#    (tipo Externo; nombre Sharpex, tu correo de contacto; ámbitos: email, profile y openid).
# 2. «Credenciales» → «Crear credenciales» → «ID de cliente de OAuth» → tipo «Aplicación web».
#    En «URIs de redirección autorizados» pon EXACTAMENTE <PUBLIC_URL>/api/auth/google/callback, por ejemplo:
#      https://sharpex.tudominio.com/api/auth/google/callback      (producción, con HTTPS)
#      http://localhost:8090/api/auth/google/callback               (en tu ordenador: con http sólo vale localhost)
# 3. Copia aquí el ID y el secreto. PUBLIC_URL es la dirección desde la que se entra a la web, sin / al final.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# PUBLIC_URL=https://sharpex.tudominio.com

# Pon COOKIE_SECURE=1 cuando la web se sirva por HTTPS: la cookie de sesión sólo viajará cifrada.
# No lo actives sin HTTPS o no podrás iniciar sesión.
# COOKIE_SECURE=1

# ---------- Producción (docker-compose.prod.yml, npm run backend:prod) ----------
# Todos obligatorios en producción: sin ellos Docker Compose no arranca. En desarrollo no hacen falta.
# Genera los secretos con:  openssl rand -hex 32
# POSTGRES_PASSWORD=
# Firma las cabeceras de usuario entre el gateway y los servicios
# INTERNAL_SECRET=
# Token que el lector manda al gateway; con él las rutas /jobs y /odds dejan de estar abiertas (y sin CORS)
# LECTOR_TOKEN=
# Administrador que se crea al arrancar si aún no hay usuarios (así el primer registro público no es administrador)
# ADMIN_USER=
# ADMIN_PASSWORD=
