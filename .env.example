# Copia este fichero como .env en la carpeta del proyecto (junto a docker-compose.yml) y rellena lo que uses.
# Docker Compose lo pasa a los servicios del backend. El .env no se sube a git.
# Lo que pongas aquí manda sobre lo guardado en Ajustes. Tras cambiarlo: npm run backend

# Leaguepedia (opcional): "bot password" de Fandom para subir el límite de consultas.
# Créala en https://lol.fandom.com/wiki/Special:BotPasswords (sólo permiso de lectura).
LEAGUEPEDIA_USER=TuUsuario@app
LEAGUEPEDIA_PASSWORD=

# lolesports.com: clave pública que usa su propia web (ya viene puesta en la app; sólo si cambia)
# LOLESPORTS_KEY=

# Base de datos (PostgreSQL en Docker). Sólo se abre en 127.0.0.1; si no pones nada se usa lolet/lolet.
# Cámbialos antes del primer arranque: después la base de datos ya está creada con los anteriores.
# POSTGRES_USER=lolet
# POSTGRES_PASSWORD=lolet
# POSTGRES_DB=lolet
# Puerto de Adminer (visor web de la base de datos) en 127.0.0.1; por defecto 8080.
# ADMINER_PORT=8080
# WEB_PORT=8090
# WEB_BIND=127.0.0.1  # para que la web no se abra a la red (por defecto se puede entrar desde el móvil)
